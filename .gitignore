# ==============================================================================
# InnoStudio - Git Ignore Rules
# Keep all personal credentials, tokens, network IPs, and local caches private
# ==============================================================================

# Authentication & Tokens
*_token.txt
*token.txt
*token.js
*token.json
myinnox1-local/token.js
myinnox1-local/token.json
.env
.env.*
!.env.example

# Local Configuration files (use *.example.json for tracked templates)
tapo_config.json
opengym_config.json
power_settings.json

# Local Workout Data & Sync Caches
last_sync.json
mapping.json
hevy_id_map.json
sync_history.json

# Process Logs & Output
*.log
*.err

# Python & Environment
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/

# Operating System & IDE
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
