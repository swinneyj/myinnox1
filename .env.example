# InnoStudio Environment Overrides (Optional)

# OpenGym instance URL (defaults to http://localhost:8080)
# OPENGYM_URL=http://localhost:8080

# Tapo Smart Plug details (or configure tapo_config.json)
# TAPO_HOST=192.168.1.100
# TAPO_USERNAME=your-tapo-email@example.com

# InnoStudio Local Web Port (default: 8085)
# PORT=8085
